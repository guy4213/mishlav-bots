# voice-worker settings. Copy to apps/voice-worker/.env (git-ignored).
# TOOLS_SECRET / TOOLS_BASE_URL are also read from the repo-root .env, so they need not be repeated here.

# --- LiveKit Cloud (project settings -> keys) ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Provider C: Gemini Live ---
VOICE_PROVIDER=gemini
# Gemini API key from https://aistudio.google.com (or use Vertex: GOOGLE_GENAI_USE_VERTEXAI=true + service account)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# GEMINI_MODEL=gemini-3.8-live-extended-thinking   # A/B: better reasoning, maybe slower; tools go non-blocking
# GEMINI_THINKING_LEVEL=low                         # extended-thinking only: low | medium | high
# Gemini Live voice name (prebuilt voices; pick by blind listening)
GEMINI_VOICE=Kore
# blocking = the model waits for a tool result before speaking (needed for get_day_info before quoting)
GEMINI_TOOL_BEHAVIOR=blocking
GEMINI_API_VERSION=v1alpha
GEMINI_TEMPERATURE=0.6

# --- Provider B: Soniox STT -> Gemini text -> ElevenLabs TTS (VOICE_PROVIDER=soniox_eleven) ---
# `npm run lab` starts a second worker for B (agent mishlav-b, WORKER_PORT=8082) when these keys exist.
# SONIOX_API_KEY=
# SONIOX_MODEL=stt-rt-v5
# ELEVENLABS_API_KEY=            (elevenLabsAgentsKey also works)
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# B_LLM_MODEL=gemini-3.8-flash
# WORKER_PORT=8081               (health port; set per worker when running several)

# --- Bot ---
BOT_NAME=נועה
# Name the dispatch rule targets (explicit dispatch). Default mishlav-c (C) / mishlav-b (B).
# AGENT_NAME=mishlav-c

# --- Tools server (Part 1) ---
# Worker runs on the same machine as the tools server -> no ngrok needed for the tools.
# TOOLS_BASE_URL=http://127.0.0.1:8787
# TOOLS_SECRET=  (from the repo-root .env)
