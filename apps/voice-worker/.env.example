# voice-worker settings. Copy to apps/voice-worker/.env (git-ignored).
# TOOLS_SECRET / TOOLS_BASE_URL are also read from the repo-root .env, so they need not be repeated here.

# --- LiveKit Cloud (project settings -> keys) ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Provider C: Gemini Live ---
VOICE_PROVIDER=gemini
# Gemini API key from https://aistudio.google.com (or use Vertex: GOOGLE_GENAI_USE_VERTEXAI=true + service account)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Gemini Live voice name (prebuilt voices; pick by blind listening)
GEMINI_VOICE=Kore
# blocking = the model waits for a tool result before speaking (needed for get_day_info before quoting)
GEMINI_TOOL_BEHAVIOR=blocking
GEMINI_TEMPERATURE=0.6

# --- Bot ---
BOT_NAME=נועה
# Name the dispatch rule targets (explicit dispatch). Leave as is unless you run several workers.
AGENT_NAME=mishlav-c

# --- Tools server (Part 1) ---
# Worker runs on the same machine as the tools server -> no ngrok needed for the tools.
# TOOLS_BASE_URL=http://127.0.0.1:8787
# TOOLS_SECRET=  (from the repo-root .env)
