# Shared secret for every /tools/* and /test/* request (>= 16 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TOOLS_SECRET=change-me-to-a-long-random-string

PORT=8787
# Loopback only; ngrok forwards here. 0.0.0.0 would expose the server on the LAN.
HOST=127.0.0.1
# LOG_DIR=logs

# Optional: set to open an ngrok tunnel in-process with `npm run dev:tunnel`
# NGROK_AUTHTOKEN=

# Used by scripts (session / simulate). Point at the ngrok URL to smoke-test the tunnel.
TOOLS_BASE_URL=http://127.0.0.1:8787

# --- LiveKit + Gemini (providers B, C; see apps/voice-worker/.env.example for all worker options) ---
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# GOOGLE_API_KEY=

# --- Provider A: ElevenLabs Agents (also B's TTS). `npm run lab` creates/updates the agent automatically
# (ids in .elevenlabs.json) and points its 5 tools at the ngrok tunnel (needs an ngrok authtoken).
# ELEVENLABS_API_KEY=            (elevenLabsAgentsKey also works)
# ELEVENLABS_AGENT_ID=           optional: use an existing agent instead of .elevenlabs.json
# ELEVENLABS_LLM=gemini-3.8-flash
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo   (Hebrew: eleven_v4_turbo / eleven_v3; flash_v2_5 has no Hebrew)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_LANGUAGE=he

# --- Provider B: Soniox STT (+ ElevenLabs TTS + GOOGLE_API_KEY for the LLM) ---
# SONIOX_API_KEY=
